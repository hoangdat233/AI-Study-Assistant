# Shared
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_NAME=AI Study Assistant API
APP_ENV=development
APP_DEBUG=true
# Note: port 5433 avoids conflict with any locally-installed PostgreSQL on port 5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_study_assistant
JWT_SECRET_KEY=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_DB=ai_study_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
