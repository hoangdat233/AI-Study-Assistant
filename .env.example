# Shared Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend Configuration
APP_NAME=AI Study Assistant API
APP_ENV=development
APP_DEBUG=true

# Database Configuration (Host port 5433 avoids conflict with local PostgreSQL 5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_study_assistant

# Security & CORS
JWT_SECRET_KEY=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Container Defaults
POSTGRES_DB=ai_study_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AI / Gemini Model Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash
